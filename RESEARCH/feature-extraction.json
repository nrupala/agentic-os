    {
      "feature_name": "Tool System Architecture",
      "source_repo": "collection-claude-code-source-code",
      "implementation_pattern": "40+ built-in tools: FileRead/Edit/Write, Glob, Grep, Bash, WebFetch/Search, Tasks, Sub-agents, Code Environments, Git Workflow, Memory/Planning",
      "integration_point": "paradise.py -> ToolPool -> Builder (Aider)",
      "details": {
        "permission_system": "Three modes: default (ask), bypass (auto-allow), strict (auto-deny)",
        "protocol": "MCP (Model Context Protocol)"
      }
    },
    {
      "feature_name": "Three-Layer Memory Architecture",
      "source_repo": "collection-claude-code-source-code",
      "implementation_pattern": "Layer 1: In-Context (active window), Layer 2: External File Memory (memory.md index), Layer 3: Project-level static config (CLAUDE.md)",
      "integration_point": "cognition/knowledge_graph.py -> Memory Management",
      "details": {
        "layer_1": "In-context memory - conversation history in active window",
        "layer_2": "External file memory - memory.md as pointer index to domain-specific files",
        "layer_3": "Static project config - CLAUDE.md at project root",
        "self_healing": "Agent rewrites memory files when information changes"
      }
    },
    {
      "feature_name": "Multi-Provider Pattern",
      "source_repo": "collection-claude-code-source-code",
      "implementation_pattern": "Unified tool registry with memoized assembly, feature-gated modules using Bun feature() function",
      "integration_point": "paradise.py -> Provider abstraction layer",
      "details": {
        "architecture": "getTools() and getCommands() use memoized assembly functions",
        "extensibility": "Add new capability by creating self-contained tool module with input schema, permission model, execution logic"
      }
    },
    {
      "feature_name": "Skill Format Specification",
      "source_repo": "everything-claude-code",
